<%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen font-sans antialiased" x-data="{ openModal: false, step: 1, email: '', error: '', success: '' }">
  <%- include('../partials/nav') %>
  <%- include('../partials/animation') %>
  <%- include('../partials/toast') %>

  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white shadow-xl rounded-2xl w-full max-w-md p-10 border border-gray-200 flex flex-col gap-6">

      <!-- Title -->
      <h1 class="text-3xl font-extrabold text-center text-green-700 drop-shadow mb-4">
        Student Login
      </h1>
      <p class="text-center text-gray-600 mb-6">
        Enter your enrollment number and password to access your dashboard.
      </p>

      <!-- Error Message -->
      <%- include('../partials/error') %>

      <!-- Login Form -->
      <form action="/login" method="POST" class="flex flex-col gap-4">
        <input type="hidden" name="userType" value="student" />

        <div>
          <label for="enrollmentNo" class="block text-gray-700 font-semibold mb-1">Enrollment Number</label>
          <input
            type="text"
            name="enrollmentNo"
            id="enrollmentNo"
            placeholder="Enter your enrollment number"
            value="<%= oldInput.enrollmentNumber %>"
            required
            class="w-full border border-gray-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 transition"
          />
        </div>

        <div>
          <label for="password" class="block text-gray-700 font-semibold mb-1">Password</label>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Enter your password"
            required
            class="w-full border border-gray-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 transition"
          />
        </div>

        <!-- Forgot Password Button -->
        <div class="mt-1">
          <button
            type="button"
            class="text-sm text-green-600 hover:underline"
            @click="openModal = true; step = 1; error=''; success='';"
          >
            Forgot Password?
          </button>
        </div>

        <input
          type="submit"
          value="Login"
          class="w-full bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700 shadow transition"
        />
      </form>

      <!-- Signup Link -->
      <div class="flex items-center justify-center gap-2 mt-4">
        Don't have an account?
        <form action="/signup" class="text-green-600 font-semibold hover:underline">
          <input type="text" hidden name="userType" value="student" />
          <button type="submit">Sign up</button>
        </form>
      </div>

    </div>
  </div>

  <!-- Modal -->
  <div
    x-show="openModal"
    class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50"
  >
    <div
      class="bg-white rounded-xl shadow-lg p-6 w-96 relative"
      @click.away="openModal = false"
      x-transition
    >
      <!-- Step 1: Enter Email -->
      <template x-if="step === 1">
        <div>
          <h2 class="text-xl font-bold text-green-700 mb-4">Reset Password</h2>
          <p class="text-gray-600 mb-4">Enter your registered email to continue.</p>

          <form
            @submit.prevent="
              error='';
              success='';
              if (email.trim() === '') {
                error='Please enter an email.';
              } else {
                fetch('/check-email', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email })
                })
                .then(res => res.json())
                .then(data => {
                  if (data.valid) {
                    step = 2;
                  } else {
                    error='Email not found.';
                  }
                })
                .catch(() => error='Something went wrong.');
              }
            "
            class="flex flex-col gap-4"
          >
            <input
              type="email"
              x-model="email"
              placeholder="Enter your registered email"
              required
              class="border border-gray-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 transition"
            />

            <p x-show="error" class="text-red-500 text-sm" x-text="error"></p>

            <div class="flex justify-end gap-2 mt-2">
              <button
                type="button"
                class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300 transition"
                @click="openModal = false"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition"
              >
                Continue
              </button>
            </div>
          </form>
        </div>
      </template>

      <!-- Step 2: Enter New Password -->
      <template x-if="step === 2">
        <div>
          <h2 class="text-xl font-bold text-green-700 mb-4">Set New Password</h2>
          <p class="text-gray-600 mb-4">Enter and confirm your new password for <span class="font-semibold" x-text="email"></span>.</p>

          <form
            @submit.prevent="
              error='';
              const newPass = $refs.newPass.value;
              const confirmPass = $refs.confirmPass.value;
              if (newPass.length < 6) {
                error='Password must be at least 6 characters.';
              } else if (newPass !== confirmPass) {
                error='Passwords do not match.';
              } else {
                fetch('/reset-password', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email, password: newPass })
                })
                .then(res => res.json())
                .then(data => {
                  if (data.success) {
                    success='Password reset successful!';
                    setTimeout(() => { openModal=false; }, 1500);
                  } else {
                    error=data.message || 'Something went wrong.';
                  }
                })
                .catch(() => error='Server error.');
              }
            "
            class="flex flex-col gap-4"
          >
            <input
              type="password"
              x-ref="newPass"
              placeholder="New password"
              required
              class="border border-gray-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 transition"
            />
            <input
              type="password"
              x-ref="confirmPass"
              placeholder="Confirm password"
              required
              class="border border-gray-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-400 transition"
            />

            <p x-show="error" class="text-red-500 text-sm" x-text="error"></p>
            <p x-show="success" class="text-green-600 text-sm font-semibold" x-text="success"></p>

            <div class="flex justify-end gap-2 mt-2">
              <button
                type="button"
                class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300 transition"
                @click="openModal = false"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition"
              >
                Reset Password
              </button>
            </div>
          </form>
        </div>
      </template>
    </div>
  </div>

  <!-- Alpine.js -->
  <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</body>
</html>
